<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- JSON-line stdout for log-aggregator ingestion (Loki / Datadog / etc).
         Emits one object per line with stable keys: ts, level, logger, thread,
         msg, plus any MDC fields (tx_hash, block_number, pool_address, score,
         heuristic). -->
    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>ts</timestamp>
                <level>level</level>
                <logger>logger</logger>
                <thread>thread</thread>
                <message>msg</message>
                <stackTrace>stack</stackTrace>
                <mdc>[ignore]</mdc>
            </fieldNames>
            <includeMdcKeyName>tx_hash</includeMdcKeyName>
            <includeMdcKeyName>block_number</includeMdcKeyName>
            <includeMdcKeyName>pool_address</includeMdcKeyName>
            <includeMdcKeyName>token_address</includeMdcKeyName>
            <includeMdcKeyName>deployer_address</includeMdcKeyName>
            <includeMdcKeyName>score</includeMdcKeyName>
            <includeMdcKeyName>heuristic</includeMdcKeyName>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_STDOUT"/>
    </root>

    <logger name="io.github.xbta4224j.scanner" level="DEBUG"/>
    <logger name="org.web3j.protocol" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.testcontainers" level="WARN"/>

</configuration>
